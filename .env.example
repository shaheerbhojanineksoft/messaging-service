# ── Messaging Service — environment template ────────────────────────────────
# Copy to `.env` (auto-loaded by Bun) and fill in real values.

# --- Service ---
PORT=3003

# --- Mongo (conversations + messages collections live in this DB) ---
DATABASE_URL=mongodb://localhost:27017
# TODO: confirm the official messaging DB name
DATABASE_NAME=Traderverse-Messaging

# --- Auth mode (who verifies the user's token) ---
# true  (DEFAULT) → APISIX (openid-connect) verified the token and injects
#                   `X-Userinfo`: the protected routes only read that header.
# false           → no gateway in front: THIS service verifies the raw
#                   `Authorization: Bearer <token>` itself against Keycloak's
#                   JWKS (signature + `iss` + expiry) and takes the identity
#                   from the VERIFIED claims. `X-Userinfo` is IGNORED then.
# Same flag/semantics as user-and-identity-service.
GATEWAY_AUTH_ENABLED=true
# Keycloak issuer — only needed when GATEWAY_AUTH_ENABLED=false
KEYCLOAK_BASE_URL=https://of-auth.traderverse.io/auth
KEYCLOAK_REALM_NAME=traderverse
# Optional overrides (blank ⇒ derived from the issuer above)
KEYCLOAK_JWKS_URL=
# Extra accepted `iss` values, comma separated (blank ⇒ the issuer only)
KEYCLOAK_ISSUERS=
# Tolerated clock skew (seconds) when verifying a token locally
KEYCLOAK_CLOCK_TOLERANCE_SECONDS=5

# --- Firebase / Firestore (same project as the webapi) ---
# 1) EMULATOR: set FIRESTORE_EMULATOR_HOST to use the local Firestore emulator
#    (e.g. 127.0.0.1:8081). Leave blank to use real Firebase.
FIRESTORE_EMULATOR_HOST=

# 2) REAL FIREBASE via service account (projectId/clientEmail/privateKey).
#    privateKey must be the PEM including the BEGIN/END lines. If pasted with
#    literal \n sequences, they are converted to real newlines automatically.
FIREBASE_PROJECT_ID=traderverse-75f26
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Kept for parity with the webapi firebase-admin init (RTDB/Storage, not Firestore).
FIREBASE_DATABASE_URL=https://internaldev-361116-default-rtdb.firebaseio.com/
FIREBASE_STORAGE_BUCKET=gs://internaldev-361116.appspot.com
